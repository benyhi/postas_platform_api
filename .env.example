APP_NAME=Postas Platform API
API_PREFIX=/api/v1
DATABASE_URL=sqlite:///./postas_platform.db
# Docker Compose usa PostgreSQL por defecto; PLATFORM_DATABASE_URL permite reemplazarlo.
PLATFORM_DATABASE_URL=
PLATFORM_POSTGRES_DB=postas_platform
PLATFORM_POSTGRES_USER=postas_platform
PLATFORM_POSTGRES_PASSWORD=

# Internal service-to-service security for /internal/v1.
POSTAS_SERVICE_TOKEN=local-service-token
POSTAS_SERVICE_TOKEN_HEADER=X-Postas-Service-Token
POSTAS_SERVICE_SOURCE_HEADER=X-Postas-Source
ALLOWED_REQUEST_SOURCES=postas_api,postas_ai_api
POSTAS_INTERNAL_REQUIRE_TLS=true

# ARCA multi-tenant. ARCA_CREDENTIAL_MASTER_KEYS accepts a JSON object whose
# values are Fernet keys, for example {"2026-01":"<base64-key>"}.
# There are intentionally no development or production fallback keys.
ARCA_CREDENTIAL_MASTER_KEYS=
ARCA_CREDENTIAL_ACTIVE_KEY_ID=
ARCA_PRODUCTION_CALLS_ENABLED=false
ARCA_TIMEOUT_SECONDS=30
ARCA_WORKER_POLL_SECONDS=5
ARCA_WORKER_BATCH_SIZE=20
ARCA_CONSUMER_FINAL_IDENTIFICATION_THRESHOLD=10000000

# Mercado Pago OAuth y Orders API. El redirect debe ser HTTPS y coincidir con
# la URL registrada en la aplicacion de Mercado Pago.
MERCADO_PAGO_CLIENT_ID=
MERCADO_PAGO_CLIENT_SECRET=
MERCADO_PAGO_REDIRECT_URI=https://platform.example.com/api/v1/mercado-pago/oauth/callback
MERCADO_PAGO_API_BASE_URL=https://api.mercadopago.com
MERCADO_PAGO_AUTH_BASE_URL=https://auth.mercadopago.com
MERCADO_PAGO_PLATFORM_ID=
MERCADO_PAGO_APPLICATION_ID=
MERCADO_PAGO_INTEGRATOR_ID=
MERCADO_PAGO_CONNECT_TIMEOUT_SECONDS=5
MERCADO_PAGO_READ_TIMEOUT_SECONDS=20
MERCADO_PAGO_WRITE_TIMEOUT_SECONDS=20
MERCADO_PAGO_OAUTH_STATE_TTL_SECONDS=600
MERCADO_PAGO_REFRESH_SKEW_SECONDS=300
# JSON key_id -> Fernet key. Conservar claves anteriores durante una rotacion.
MERCADO_PAGO_CREDENTIAL_MASTER_KEYS=
MERCADO_PAGO_CREDENTIAL_ACTIVE_KEY_ID=

# Legacy AI processing security. These endpoints remain available while the
# service is migrated from postas_ai_api to postas_platform_api.
POSTAS_AI_API_TOKEN=token-acceso-test
REQUIRE_API_TOKEN=true
POSTAS_AI_TOKEN_HEADER=X-Postas-AI-Token
POSTAS_AI_SOURCE_HEADER=X-Postas-Source

# AI providers
AI_PROVIDER=google_genai
FALLBACK_AI_PROVIDER=
MAX_AI_ATTEMPTS=1

# Gemini
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash-lite

# Image download
IMAGE_DOWNLOAD_TIMEOUT_SECONDS=15
MAX_IMAGE_BYTES=10485760

# Confidence thresholds
ACCEPTED_CONFIDENCE_THRESHOLD=0.85
MINIMUM_CONFIDENCE_THRESHOLD=0.60

# Optional cost estimation by provider/model pricing.
INPUT_TOKEN_COST_PER_MILLION=0.10
OUTPUT_TOKEN_COST_PER_MILLION=0.40
